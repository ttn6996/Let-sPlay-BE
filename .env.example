SERVER_PORT=8082
DB_URL=jdbc:postgresql://localhost:5432/letsplay?sslmode=disable
DB_USERNAME=postgres
DB_PASSWORD=
CORS_ALLOWED_ORIGIN_PATTERNS=*
PUSH_VAPID_PUBLIC_KEY=
PUSH_VAPID_PRIVATE_KEY=
PUSH_VAPID_SUBJECT=mailto:admin@letsplay.app
GOOGLE_CLIENT_ID=

# Storage configuration (Priority: google_drive -> cloudinary -> local fallback)
STORAGE_PROVIDER_ORDER=google_drive,cloudinary,local
APP_BASE_URL=http://localhost:8082

# Google Drive API (Priority 1)
GOOGLE_DRIVE_SERVICE_ACCOUNT_JSON=
GOOGLE_DRIVE_SERVICE_ACCOUNT_FILE=
GOOGLE_DRIVE_FOLDER_ID=

# Cloudinary (Fallback 1)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_FOLDER=letsplay/moments

# Local storage fallback (Fallback 2)
LOCAL_UPLOAD_DIR=./uploads/media

